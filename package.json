{
  "name": "cover-client",
  "private": true,
  "version": "0.1.7",
  "description": "Desktop GUI for cover — ELF packer using zstd compression",
  "author": "cover",
  "main": "dist-electron/main/index.js",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/electron-postinstall.cjs",
    "dev": "ELECTRON_OVERRIDE_DIST_PATH=./node_modules/electron/dist ELECTRON_SKIP_BINARY_DOWNLOAD=1 electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts --port 5174 --host ::",
    "build": "ELECTRON_SKIP_BINARY_DOWNLOAD=1 electron-vite build && electron-builder",
    "build:web": "vite build --config vite.web.config.ts",
    "build:renderer": "electron-vite build --renderer",
    "build:main": "electron-vite build --main",
    "build:preload": "electron-vite build --preload",
    "preview": "vite preview",
    "preview:web": "vite preview --config vite.web.config.ts",
    "lint": "eslint .",
    "start": "ELECTRON_OVERRIDE_DIST_PATH=./node_modules/electron/dist ELECTRON_SKIP_BINARY_DOWNLOAD=1 electron ."
  },
  "dependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-virtual": "^3.0.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "42",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "rollup": "^4.60.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.10",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0"
  }
}
